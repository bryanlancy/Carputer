#!/bin/sh
# Test password authentication for carputer user

echo "=== Password Authentication Test ==="
echo ""

# Check shadow entry
echo "1. Checking /etc/shadow entry:"
if grep -q '^carputer:' /etc/shadow; then
    SHADOW_ENTRY=$(grep '^carputer:' /etc/shadow)
    echo "   ✓ Found: ${SHADOW_ENTRY}"
    PASSWORD_FIELD=$(echo "${SHADOW_ENTRY}" | cut -d: -f2)
    if [ -z "${PASSWORD_FIELD}" ]; then
        echo "   ✗ Password field is EMPTY"
    elif [ "${PASSWORD_FIELD}" = "*" ]; then
        echo "   ✗ Account is LOCKED (*)"
    elif [ "${PASSWORD_FIELD}" = "!" ]; then
        echo "   ✗ Account is DISABLED (!)"
    elif echo "${PASSWORD_FIELD}" | grep -q '^\$[156]\$'; then
        echo "   ✓ Password hash found (${PASSWORD_FIELD:0:20}...)"
    else
        echo "   ⚠ Password field format unclear: ${PASSWORD_FIELD:0:20}..."
    fi
else
    echo "   ✗ carputer user not found in /etc/shadow"
    exit 1
fi

echo ""
echo "2. Testing password hash:"
if command -v python3 >/dev/null 2>&1; then
    TEST_HASH=$(python3 -c "import crypt; hash='${PASSWORD_FIELD}'; result=crypt.crypt('carputer', hash); print('MATCH' if result == hash else 'NO MATCH')" 2>/dev/null)
    echo "   ${TEST_HASH}"
elif command -v openssl >/dev/null 2>&1; then
    echo "   (Cannot test with openssl - use python3 or test manually)"
else
    echo "   (No tools available to test hash)"
fi

echo ""
echo "3. Checking SSH configuration:"
if [ -f /etc/ssh/sshd_config ]; then
    if grep -q "^PasswordAuthentication yes" /etc/ssh/sshd_config; then
        echo "   ✓ PasswordAuthentication is enabled"
    elif grep -q "^PasswordAuthentication no" /etc/ssh/sshd_config; then
        echo "   ✗ PasswordAuthentication is DISABLED"
    else
        echo "   ⚠ PasswordAuthentication not set (defaults to yes)"
    fi

    if grep -q "^UsePAM yes" /etc/ssh/sshd_config; then
        echo "   ⚠ UsePAM is enabled (requires PAM configuration)"
    else
        echo "   ✓ UsePAM not enabled (using direct password check)"
    fi
else
    echo "   ✗ /etc/ssh/sshd_config not found"
fi

echo ""
echo "4. Checking user account:"
if id carputer >/dev/null 2>&1; then
    echo "   ✓ carputer user exists"
    echo "   UID: $(id -u carputer)"
    echo "   GID: $(id -g carputer)"
    echo "   Shell: $(getent passwd carputer | cut -d: -f7)"
else
    echo "   ✗ carputer user does not exist"
fi

echo ""
echo "5. Checking shell availability:"
USER_SHELL=$(getent passwd carputer | cut -d: -f7)
if [ -x "${USER_SHELL}" ]; then
    echo "   ✓ Shell ${USER_SHELL} is executable"
else
    echo "   ✗ Shell ${USER_SHELL} is NOT executable"
fi

if [ -f /etc/shells ]; then
    if grep -q "^${USER_SHELL}$" /etc/shells; then
        echo "   ✓ Shell ${USER_SHELL} is in /etc/shells"
    else
        echo "   ✗ Shell ${USER_SHELL} is NOT in /etc/shells"
    fi
fi

echo ""
echo "=== Manual Test ==="
echo "To test password authentication manually:"
echo "  1. Try: ssh -v carputer@<ip-address>"
echo "  2. Check sshd logs: journalctl -u sshd (if systemd) or check /var/log"
echo "  3. Run sshd in debug mode: /usr/sbin/sshd -D -e"
echo ""


