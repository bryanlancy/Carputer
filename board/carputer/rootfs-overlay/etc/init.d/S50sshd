#!/bin/sh
#
# sshd        Starts sshd.
#

DAEMON="sshd"
PIDFILE="/var/run/$DAEMON.pid"

# Make sure the ssh-keygen program exists
[ -f /usr/bin/ssh-keygen ] || exit 0

umask 077

start() {
	# Ensure required directories exist (should already exist from build, but be safe)
	mkdir -p /var/empty
	chmod 755 /var/empty

	# Verify SSH host keys exist (should be generated during build)
	if [ ! -f /etc/ssh/ssh_host_rsa_key ] && [ ! -f /etc/ssh/ssh_host_ecdsa_key ] && [ ! -f /etc/ssh/ssh_host_ed25519_key ]; then
		echo "WARNING: No SSH host keys found, generating..." >&2
		/usr/bin/ssh-keygen -A >/dev/null 2>&1
	fi

	# Ensure key permissions are correct (should be set during build, but fix if needed)
	chmod 600 /etc/ssh/ssh_host_*_key 2>/dev/null || true
	chmod 644 /etc/ssh/ssh_host_*_key.pub 2>/dev/null || true
	chown root:root /etc/ssh/ssh_host_*_key* 2>/dev/null || true

	printf "Starting %s: " "$DAEMON"
	start-stop-daemon --start --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

stop() {
	printf "Stopping sshd: "
	start-stop-daemon --stop --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	# sshd deletes its PID file on exit, wait for it to be gone
	while [ -f "$PIDFILE" ]; do
		sleep 0.1
	done
	# Also kill any remaining sshd processes
	killall sshd 2>/dev/null || true
	return "$status"
}

restart() {
	stop
	start
}

reload() {
	printf "Reloading sshd config: "
	start-stop-daemon --stop --signal HUP -q --pidfile "$PIDFILE" \
		--exec "/usr/sbin/$DAEMON"
	status=$?
	if [ "$status" -eq 0 ]; then
		echo "OK"
	else
		echo "FAIL"
	fi
	return "$status"
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart)
		restart
		;;
	reload)
		reload
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac

exit $?



