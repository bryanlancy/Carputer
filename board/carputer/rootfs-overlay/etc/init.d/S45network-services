#!/bin/sh

case "$1" in
  start)
    if [ -x /etc/init.d/S40dbus ]; then
      /etc/init.d/S40dbus start
    elif command -v dbus-daemon >/dev/null 2>&1; then
      dbus-uuidgen --ensure
      dbus-daemon --system
    fi

    if [ -x /etc/init.d/S50avahi-daemon ]; then
      /etc/init.d/S50avahi-daemon start
    elif command -v avahi-daemon >/dev/null 2>&1; then
      avahi-daemon --daemonize
    fi
    ;;
  stop)
    if [ -x /etc/init.d/S50avahi-daemon ]; then
      /etc/init.d/S50avahi-daemon stop
    elif command -v avahi-daemon >/dev/null 2>&1; then
      killall avahi-daemon
    fi

    if [ -x /etc/init.d/S40dbus ]; then
      /etc/init.d/S40dbus stop
    elif command -v dbus-daemon >/dev/null 2>&1; then
      killall dbus-daemon
    fi
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}" >&2
    exit 1
    ;;
esac

exit 0

