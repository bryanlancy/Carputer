// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id                      Int       @id @default(autoincrement())
  device_id               String    @unique @db.VarChar(255)
  mac_address             String?   @unique @db.VarChar(17)
  hostname                String?   @db.VarChar(255)
  vin                     String?   @db.VarChar(255)
  hardware_rev            String?   @db.VarChar(255)
  build_id                String?   @db.VarChar(255)
  current_version         String?   @db.VarChar(255)
  current_build_id        String?   @db.VarChar(255)
  current_ip              String?   @db.Inet
  uptime                  BigInt?
  services_status         Json?
  status                  String    @default("offline") @db.VarChar(50)
  last_seen               DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt

  // Image verification fields
  image_id                Int?
  image                   Image?    @relation(fields: [image_id], references: [id], onDelete: SetNull)
  image_signature         String?   @db.VarChar(512)
  image_build_hash        String?   @db.VarChar(255)
  image_verified          Boolean   @default(false)
  image_verified_at       DateTime?

  // Authorization fields
  authorized              Boolean   @default(false)
  authorized_at           DateTime?
  authorized_by           String?   @db.VarChar(255)

  // Registration metadata
  registration_method     String    @default("manual") @db.VarChar(50)
  registration_ip         String?   @db.Inet
  first_seen              DateTime?
  last_registration_attempt DateTime?

  // Relations
  commands                Command[]
  device_logs             DeviceLog[]
  notifications           Notification[]

  @@index([device_id])
  @@index([status])
  @@index([last_seen])
  @@index([mac_address])
  @@index([image_id])
  @@map("devices")
}

model Command {
  id          Int       @id @default(autoincrement())
  device_id   Int
  device      Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  command     String    @db.VarChar(100)
  parameters  Json?
  status      String    @default("pending") @db.VarChar(50)
  result      Json?
  error       String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  completed_at DateTime?

  @@index([device_id])
  @@index([status])
  @@index([created_at])
  @@map("commands")
}

model DeviceLog {
  id          Int       @id @default(autoincrement())
  device_id   Int
  device      Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  log_type    String?   @db.VarChar(100)
  log_path    String?   @db.VarChar(500)
  uploaded_at DateTime  @default(now())
  file_size   BigInt?
  metadata    Json?

  // Relations
  notifications          Notification[]

  @@index([device_id])
  @@map("device_logs")
}

model Image {
  id                Int       @id @default(autoincrement())
  image_build_hash  String    @unique @db.VarChar(255)
  image_signature   String?   @db.Text
  build_id          String?   @db.VarChar(255)
  git_sha           String?   @db.VarChar(255)
  build_timestamp   DateTime?
  verified          Boolean   @default(false)
  verified_at       DateTime?
  verified_by       String?   @db.VarChar(255)
  is_active         Boolean   @default(true)
  notes             String?   @db.Text
  changelog         String?   @db.Text
  is_latest         Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  // Relations
  devices           Device[]

  @@index([image_build_hash])
  @@index([verified])
  @@index([is_active])
  @@index([is_latest])
  @@map("images")
}

model DeviceRegistrationAttempt {
  id                  Int       @id @default(autoincrement())
  mac_address         String?   @db.VarChar(17)
  device_id           String?   @db.VarChar(255)
  ip_address          String?   @db.Inet
  image_build_hash    String?   @db.VarChar(255)
  image_signature     String?   @db.VarChar(512)
  registration_method String?   @db.VarChar(50)
  success             Boolean?
  error_message       String?   @db.Text
  created_at          DateTime  @default(now())

  @@index([mac_address])
  @@index([created_at])
  @@map("device_registration_attempts")
}

model NotificationType {
  id          Int       @id @default(autoincrement())
  type_code   String    @unique @db.VarChar(100)
  type_name   String    @db.VarChar(255)
  description String?   @db.Text
  severity    String    @default("info") @db.VarChar(50) // info, warning, error, critical
  enabled     Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt

  // Relations
  notifications       Notification[]

  @@index([type_code])
  @@index([enabled])
  @@map("notification_types")
}

model Notification {
  id                  Int             @id @default(autoincrement())
  device_id           Int
  device              Device          @relation(fields: [device_id], references: [id], onDelete: Cascade)
  notification_type_id Int
  notification_type   NotificationType @relation(fields: [notification_type_id], references: [id], onDelete: Restrict)
  device_log_id       Int?
  device_log          DeviceLog?      @relation(fields: [device_log_id], references: [id], onDelete: SetNull)
  title               String          @db.VarChar(255)
  message             String?         @db.Text
  metadata            Json?
  read                Boolean         @default(false)
  read_at             DateTime?
  created_at          DateTime        @default(now())

  @@index([device_id])
  @@index([notification_type_id])
  @@index([device_log_id])
  @@index([read])
  @@index([created_at])
  @@map("notifications")
}

