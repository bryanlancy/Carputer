// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id                      Int       @id @default(autoincrement())
  device_id               String    @unique @db.VarChar(255)
  mac_address             String?   @unique @db.VarChar(17)
  hostname                String?   @db.VarChar(255)
  vin                     String?   @db.VarChar(255)
  hardware_rev            String?   @db.VarChar(255)
  build_id                String?   @db.VarChar(255)
  current_version         String?   @db.VarChar(255)
  current_build_id        String?   @db.VarChar(255)
  current_ip              String?   @db.Inet
  uptime                  BigInt?
  services_status         Json?
  status                  String    @default("offline") @db.VarChar(50)
  last_seen               DateTime?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @default(now()) @updatedAt

  // Image verification fields
  image_id                Int?
  image                   Image?    @relation(fields: [image_id], references: [id], onDelete: SetNull)
  image_signature         String?   @db.VarChar(512)
  image_build_hash        String?   @db.VarChar(255)
  image_verified          Boolean   @default(false)
  image_verified_at       DateTime?

  // Authorization fields
  authorized              Boolean   @default(false)
  authorized_at           DateTime?
  authorized_by           String?   @db.VarChar(255)

  // Registration metadata
  registration_method     String    @default("manual") @db.VarChar(50)
  registration_ip         String?   @db.Inet
  first_seen              DateTime?
  last_registration_attempt DateTime?

  // Relations
  commands                Command[]
  device_logs             DeviceLog[]

  @@index([device_id])
  @@index([status])
  @@index([last_seen])
  @@index([mac_address])
  @@index([image_id])
  @@map("devices")
}

model Command {
  id          Int       @id @default(autoincrement())
  device_id   Int
  device      Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  command     String    @db.VarChar(100)
  parameters  Json?
  status      String    @default("pending") @db.VarChar(50)
  result      Json?
  error       String?   @db.Text
  created_at  DateTime  @default(now())
  updated_at  DateTime  @default(now()) @updatedAt
  completed_at DateTime?

  @@index([device_id])
  @@index([status])
  @@index([created_at])
  @@map("commands")
}

model DeviceLog {
  id          Int       @id @default(autoincrement())
  device_id   Int
  device      Device    @relation(fields: [device_id], references: [id], onDelete: Cascade)
  log_type    String?   @db.VarChar(100)
  log_path    String?   @db.VarChar(500)
  uploaded_at DateTime  @default(now())
  file_size   BigInt?
  metadata    Json?


  @@index([device_id])
  @@map("device_logs")
}

model Image {
  id                Int       @id @default(autoincrement())
  image_build_hash  String    @unique @db.VarChar(255)
  image_signature   String?   @db.Text
  build_id          String?   @db.VarChar(255)
  git_sha           String?   @db.VarChar(255)
  build_timestamp   DateTime?
  verified          Boolean   @default(false)
  verified_at       DateTime?
  verified_by       String?   @db.VarChar(255)
  is_active         Boolean   @default(true)
  notes             String?   @db.Text
  changelog         String?   @db.Text
  is_latest         Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @default(now()) @updatedAt

  // Relations
  devices           Device[]

  @@index([image_build_hash])
  @@index([verified])
  @@index([is_active])
  @@index([is_latest])
  @@map("images")
}

model DeviceRegistrationAttempt {
  id                  Int       @id @default(autoincrement())
  mac_address         String?   @db.VarChar(17)
  device_id           String?   @db.VarChar(255)
  ip_address          String?   @db.Inet
  image_build_hash    String?   @db.VarChar(255)
  image_signature     String?   @db.VarChar(512)
  registration_method String?   @db.VarChar(50)
  success             Boolean?
  error_message       String?   @db.Text
  created_at          DateTime  @default(now())

  @@index([mac_address])
  @@index([created_at])
  @@map("device_registration_attempts")
}

model Notification {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(255)
  description         String?   @db.Text
  enabled             Boolean   @default(true)
  notification_type    String    @default("default") @db.VarChar(50) // warning, alert, default, success
  // Fields merged from notification_rules
  target_users        Json?     // Array of user IDs or role names, null means all users
  message_template    String?   @db.Text
  priority            Int       @default(0)
  variable_schema     Json?     // JSON Schema defining what variables this notification uses
  show_in_feed        Boolean   @default(true)
  show_popup          Boolean   @default(false)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @default(now()) @updatedAt

  // Relations
  user_notifications   UserNotification[]
  // Note: tag_associations are queried via entity_type='notification' and entity_id

  @@index([enabled])
  @@index([priority])
  @@index([show_in_feed])
  @@index([show_popup])
  @@index([notification_type])
  @@map("notifications")
}

model User {
  id                  String          @id @default(uuid()) @db.Uuid
  email               String          @unique @db.VarChar(255)
  full_name           String?         @db.VarChar(255)
  avatar_url          String?         @db.Text
  supabase_user_id    String          @unique @db.Uuid
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  // Relations
  user_roles          UserRole[]
  user_notifications  UserNotification[]
  notification_preferences UserNotificationPreferences?

  @@index([supabase_user_id])
  @@index([email])
  @@map("users")
}

model UserRole {
  id                  Int             @id @default(autoincrement())
  user_id             String          @db.Uuid
  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role                String          @db.VarChar(50) // admin, operator, viewer
  created_at          DateTime        @default(now())

  @@unique([user_id, role])
  @@index([user_id])
  @@index([role])
  @@map("user_roles")
}

model UserNotification {
  id                  Int             @id @default(autoincrement())
  user_id             String          @db.Uuid
  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  notification_id     Int
  notification        Notification    @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  viewed              Boolean         @default(false)
  viewed_at           DateTime?
  hidden              Boolean         @default(false)
  created_at          DateTime        @default(now())

  // Note: tag_associations are queried via entity_type='user_notification' and entity_id

  @@unique([user_id, notification_id], name: "user_notification_unique")
  @@index([user_id])
  @@index([notification_id])
  @@index([viewed])
  @@index([hidden])
  @@map("user_notifications")
}

model NotificationTrigger {
  id                  Int             @id @default(autoincrement())
  rule_id             Int?            // Deprecated: notification_rules table has been removed
  trigger_type        String          @db.VarChar(50) // date_time, backend_event, user_driven
  trigger_config      Json
  scheduled_at        DateTime?
  executed_at         DateTime?
  status              String          @default("pending") @db.VarChar(50) // pending, executed, failed, cancelled
  error_message       String?         @db.Text
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  @@index([rule_id])
  @@index([status])
  @@index([scheduled_at])
  @@map("notification_triggers")
}

model UserNotificationPreferences {
  id                  Int             @id @default(autoincrement())
  user_id             String          @unique @db.Uuid
  user                User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  auto_read            Boolean         @default(false)
  enabled_notification_types Json?    // Array of notification type codes
  urgency_filters     Json?           // Array of urgency levels
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  @@index([user_id])
  @@map("user_notification_preferences")
}

model Trigger {
  id                  Int             @id @default(autoincrement())
  trigger_code        String          @unique @db.VarChar(100)
  trigger_name        String          @db.VarChar(255)
  description         String?         @db.Text
  output_schema       Json            // JSON Schema defining what data this trigger emits
  enabled             Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  // Relations
  trigger_event_connections TriggerEventConnection[]

  @@index([trigger_code])
  @@index([enabled])
  @@map("triggers")
}

model Event {
  id                  Int             @id @default(autoincrement())
  event_code          String          @unique @db.VarChar(100)
  event_name          String          @db.VarChar(255)
  description         String?         @db.Text
  input_schema        Json            // JSON Schema defining what data this event requires
  handler_type        String          @db.VarChar(50) // 'notification', 'email', 'command', etc.
  enabled             Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  // Relations
  trigger_event_connections TriggerEventConnection[]

  @@index([event_code])
  @@index([enabled])
  @@index([handler_type])
  @@map("events")
}

model TriggerEventConnection {
  id                  Int             @id @default(autoincrement())
  rule_id             Int             // Deprecated: notification_rules table has been removed
  trigger_id          Int
  trigger              Trigger         @relation(fields: [trigger_id], references: [id], onDelete: Cascade)
  event_id             Int
  event                Event           @relation(fields: [event_id], references: [id], onDelete: Cascade)
  connection_config    Json?           // Additional configuration for this connection
  enabled             Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  @@unique([rule_id, trigger_id, event_id], name: "unique_rule_trigger_event")
  @@index([rule_id])
  @@index([trigger_id])
  @@index([event_id])
  @@map("trigger_event_connections")
}

model Workspace {
  id                  Int             @id @default(autoincrement())
  name                String          @db.VarChar(255)
  description         String?         @db.Text
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt
  wiring_configuration WiringConfiguration?

  @@index([name])
  @@map("workspaces")
}

model WiringConfiguration {
  id                  Int             @id @default(autoincrement())
  workspace_id        Int             @unique
  workspace           Workspace       @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  rule_id             Int?            @unique // Deprecated: notification_rules table has been removed
  nodes               Json            // React Flow nodes with positions
  edges               Json            // React Flow edges/connections
  viewport            Json?           // Viewport position/zoom
  node_config         Json?           // Per-node configuration (e.g., selected command, notification type)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  @@index([workspace_id])
  @@index([rule_id])
  @@map("wiring_configurations")
}

model Message {
  id                  Int             @id @default(autoincrement())
  message_code        String          @unique @db.VarChar(100)
  message_name        String          @db.VarChar(255)
  description         String?         @db.Text
  message_type        String          @default("email") @db.VarChar(50) // 'email', 'sms', 'webhook', etc.
  subject_template    String?         @db.Text // For emails
  body_template       String          @db.Text // Message body with variable templating
  variable_schema     Json?           // JSON Schema defining what variables this message uses and their data requirements
  enabled             Boolean         @default(true)
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  @@index([message_code])
  @@index([message_type])
  @@index([enabled])
  @@map("messages")
}

model Tag {
  id                  Int             @id @default(autoincrement())
  name                String          @unique @db.VarChar(100)
  description         String?         @db.Text
  color               String?         @db.VarChar(7) // Hex color for UI
  category            String?         @db.VarChar(50) // Optional grouping
  created_at          DateTime        @default(now())
  updated_at          DateTime        @default(now()) @updatedAt

  // Relations
  tag_associations    TagAssociation[]

  @@index([name])
  @@index([category])
  @@map("tags")
}

model TagAssociation {
  id                  Int             @id @default(autoincrement())
  tag_id              Int
  tag                 Tag             @relation(fields: [tag_id], references: [id], onDelete: Cascade)
  entity_type         String          @db.VarChar(50) // 'notification', 'user_notification', 'device', etc.
  entity_id           Int             // ID of the associated entity
  inherited           Boolean         @default(false) // true if inherited from parent entity
  created_at          DateTime        @default(now())

  // Note: Relations to Notification and UserNotification are polymorphic based on entity_type
  // Prisma doesn't support true polymorphic relations, so we use entity_type + entity_id
  // The relations above are for type safety but won't enforce foreign keys

  @@unique([tag_id, entity_type, entity_id], name: "unique_tag_association")
  @@index([entity_type, entity_id])
  @@index([tag_id])
  @@index([inherited])
  @@map("tag_associations")
}

