# Fleet Command & Control Server - Environment Configuration
# This file contains all environment variables required for docker-compose services
# Copy this file to .env and fill in the values (or run ./carputer.sh for interactive setup)

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_DB=fleet_cc
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# =============================================================================
# Security & Secrets (will be auto-generated by carputer.sh if left empty)
# =============================================================================
# JWT secret for token signing (must be at least 32 characters)
JWT_SECRET=

# Session secret for user sessions
SESSION_SECRET=

# Device registration token
DEVICE_REGISTRATION_TOKEN=

# Database encryption key for Realtime service
DB_ENC_KEY=

# =============================================================================
# Supabase Configuration
# =============================================================================
# Supabase URL (typically http://localhost:8000 for local)
SUPABASE_URL=http://localhost:8000

# External API URL for GoTrue auth service (typically http://localhost:9999)
API_EXTERNAL_URL=http://localhost:9999

# Supabase service role key (same as JWT_SECRET for self-hosted setup)
SUPABASE_SERVICE_ROLE_KEY=

# Public Supabase URL for frontend (typically http://localhost:9999 for GoTrue)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:9999

# Supabase anonymous key (same as JWT_SECRET for self-hosted setup)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# API Configuration
# =============================================================================
# API server port
API_PORT=3001

# Public API URL (for frontend and external access)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Node environment (development/production)
NODE_ENV=development

# =============================================================================
# Optional Configuration
# =============================================================================
# Enable secure channels for Realtime (true/false)
SECURE_CHANNELS=true

# Path for rsync data storage
RSYNC_TARGET_PATH=/var/fleet-data

# Headquarters WiFi SSID
HQ_WIFI_SSID=HQNetwork

# =============================================================================
# Notes:
# =============================================================================
# - For self-hosted Supabase setup:
#   * JWT_SECRET, SUPABASE_SERVICE_ROLE_KEY, and NEXT_PUBLIC_SUPABASE_ANON_KEY
#     should all be the same value
#   * Run ./carputer.sh to automatically generate and sync these values
#
# - DATABASE_URL is automatically constructed from POSTGRES_* variables
#   in docker-compose.yml, so it doesn't need to be set here
#
# - Backend and frontend services also read from backend/.env and frontend/.env
#   for local development outside of docker, but for docker-compose all variables
#   should be in this root .env file
